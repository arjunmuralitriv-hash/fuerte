# Copy to .env.local for development. Production values live in Vercel project settings.

# Canonical origin used for canonical URLs, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.fuertetechnologies.com

# IndexNow (Bing, Yandex, Seznam, Naver…): 8–128 hex characters, e.g. `node -e "console.log(crypto.randomUUID().replaceAll('-',''))"`.
# Served at /{key}.txt; scripts/indexnow.mjs pings changed URLs with it after a deploy.
INDEXNOW_KEY=

# Launch gate (scripts/content-check.mjs): set to "on" in Vercel Production at launch, so a build fails while any
# [CONFIRM]/[PLACEHOLDER] marker remains. Leave unset before launch.
CONTENT_GATE=

# Lead delivery (lib/forms/deliver.ts). In production at least one channel must be set or submissions fail loudly.
RESEND_API_KEY=
LEADS_EMAIL_TO=
# Optional routing (lib/forms/deliver.ts): pillar → extra recipients, added to LEADS_EMAIL_TO for matching RFQs.
# Pillars: technology, data-center, elv, cyber-security, resource-augmentation, amc. Example: {"elv":"elv@example.com"}
LEADS_ROUTES=
# Optional: job applications and CVs go only to these addresses (lib/forms/deliver.ts), not to LEADS_EMAIL_TO.
CAREERS_EMAIL_TO=
LEADS_EMAIL_FROM=
CRM_WEBHOOK_URL=

# Supabase project in Mumbai (ap-south-1), set up per docs/supabase-setup.md: the leads table (lib/forms/leads.ts),
# written before email and the CRM, and RFQ file uploads (lib/forms/uploads.ts).
# Server only: the secret key (sb_secret_…, or the legacy service_role key) bypasses row-level security.
# Unset locally, files are only named in the dev log; in production an RFQ with files fails until these are set.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=rfq-files
# Daily job (app/api/cron/daily): Vercel Cron sends it as a Bearer token. Any long random string.
CRON_SECRET=

# Cloudflare Turnstile (spam protection). Both empty = disabled.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional analytics and ads. Each loads only after the visitor consents (components/consent/consent-manager.tsx).
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# Error monitoring (Sentry). Empty = off and the SDK is never loaded. Read at build time; the DSN's host is added to
# the CSP connect-src automatically (next.config.ts).
SENTRY_DSN=

# Vercel Speed Insights needs no variable: enable it in the Vercel project (Speed Insights tab).

# Cloudflare Web Analytics (plan row B8): cookieless, no consent needed. Cloudflare dashboard → Analytics & Logs →
# Web Analytics → Add a site (fuertetechnologies.com) → copy the token from the JS snippet. Leave unset to load nothing.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
